# ══════════════════════════════════════════════════════════════
# BOT (Express) — local: .env | produccion: variables en Railway
# ══════════════════════════════════════════════════════════════

# Anthropic (requerido)
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-5

# Supabase — si se omiten, el bot corre en modo DEMO con datos en memoria
# Settings → API: Project URL y service_role key (secreta, solo backend)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# WhatsApp Cloud API (Meta) — fallback single-tenant; en multi-tenant van en la tabla organizations
# WHATSAPP_TOKEN: token permanente del usuario del sistema (Business Suite)
# WHATSAPP_PHONE_ID: identificador del numero (Diamond: 1218037454725710)
WHATSAPP_PHONE_ID=1234567890
WHATSAPP_TOKEN=EAAxxxxxxx
VERIFY_TOKEN=tu_token_secreto

# API interna para el CRM (proteje POST /api/send y toma de control)
BOT_API_KEY=una_clave_larga_aleatoria

# Telegram (canal de pruebas/demo, opcional)
TELEGRAM_TOKEN=123456:ABC-DEF...

# Servidor (Railway lo asigna solo via PORT)
PORT=3003

# ══════════════════════════════════════════════════════════════
# CRM (Next.js en crm/) — variables en Vercel (o crm/.env.local)
# ══════════════════════════════════════════════════════════════
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co        (misma Project URL)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                     (anon/public key)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...                         (service_role, solo server)
# BOT_API_URL=https://tu-bot.up.railway.app                (URL del bot en Railway)
# BOT_API_KEY=una_clave_larga_aleatoria                    (la misma del bot)

# ── Radar de grupos ───────────────────────────────────────────────────────
# La captura entra por dos vias que NO tocan el protocolo de WhatsApp y por lo
# tanto no son baneables: el export nativo del chat subido al CRM, y el reenvio
# de un mensaje a Sofi por la Cloud API oficial. La escucha en vivo via WAHA se
# retiro el 2026-07-30 tras el baneo de la linea de una asesora.
#
# Modelo del clasificador. NO usa CLAUDE_MODEL, que es el del bot de cara al
# cliente: esto es clasificacion en lotes y va con Haiku.
CLAUDE_MODEL_GRUPOS=claude-haiku-4-5
# Cuanto historial del export se procesa por defecto, y el tope duro de
# mensajes por corrida (la unica defensa real contra un costo sorpresa).
GROUPS_IMPORT_DIAS_DEFAULT=30
GROUPS_IMPORT_MAX_MENSAJES=20000
# Tope de avisos a leads propios POR CORRIDA de import (no por oferta, eso ya
# lo limita LIMITE_LEADS en cruce-leads.js) — evita que un import de cientos
# de ofertas dispare cientos de WhatsApps reales de golpe.
GROUPS_IMPORT_MAX_AVISOS_LEADS=20
GROUPS_CLASSIFY_CONCURRENCIA=4
# Digest diario: hora en Colombia y plantilla de Meta. GROUPS_DIGEST_TO acepta
# telefonos separados por coma para probar sin tocar a los asesores reales.
GROUPS_DIGEST_ENABLED=true
GROUPS_DIGEST_HOUR=7
WHATSAPP_DIGEST_TEMPLATE=radar_grupos
GROUPS_DIGEST_TO=
# Dias que una propiedad vista en un grupo sigue ofreciendose. Se refresca si
# el colega la republica.
ALLY_GRUPO_DIAS=7

# ── Radar en vivo (escucha y respuesta dentro de los grupos) ──────────────
#
# ⚠️ LEER ANTES DE PONER NADA DE ESTO.
#
# Esto vincula una linea por QR a WAHA, que es un cliente NO OFICIAL de
# WhatsApp. El 2026-07-30 WhatsApp baneo la linea de una asesora con este mismo
# montaje, y ese montaje SOLO LEIA: lo que se sanciona es el cliente, no la
# conducta. Reglas que no se negocian:
#
#   · La linea vinculada es una linea SECUNDARIA de la empresa, sacrificable.
#   · Nunca la de Sofi (esta en Cloud API oficial: romperia la integracion y
#     tecnicamente ni se puede parear).
#   · Nunca la de un asesor con clientes. Nunca la de Catherine.
#
# Sin GROUPS_WEBHOOK_SECRET o con GROUPS_ENABLED distinto de "true", el canal NO
# se monta: la ruta no existe en el proceso.
GROUPS_WEBHOOK_SECRET=
GROUPS_ENABLED=false
WAHA_URL=http://waha.railway.internal:8080
WAHA_API_KEY=
# La URL publica del bot, que es la que se le configura a WAHA como webhook.
BOT_PUBLIC_URL=
# Ventana del dedup por contenido: el mismo aviso difundido a varios grupos se
# responde una sola vez.
GROUPS_DEDUP_HORAS=6
# Minutos entre dos refrescos del mismo grupo en src/groups/directorio.js (a
# quien podemos escribirle: el mapeo lid -> telefono real de un colega).
# Refrescar un grupo son cientos de participantes por HTTP a WAHA (el mas
# grande tiene 878), asi que no se repite mas seguido que esto aunque lleguen
# varios pedidos del mismo grupo. Sin definirla, 10 minutos.
RADAR_DIRECTORIO_REFRESCO_MIN=10
# Cada cuanto se calienta el directorio completo en segundo plano (todos los
# grupos escuchados, ~3 s cada uno por la red interna, sin costo de IA). Se
# corre tambien a los 20 s de arrancar: el indice vive en memoria y cada
# despliegue lo borra. Auditoria 2026-09-02: sin esto, 0 telefonos guardados
# en una semana y el DM automatico salio una sola vez.
RADAR_DIRECTORIO_CALENTAR_MIN=60
# DMs al MISMO colega por dia. Juan lo subio de 1 a 2 el 2026-09-02: dos
# pedidos distintos merecen dos respuestas; el dedup por contenido ya evita
# responder dos veces el mismo pedido difundido a varios grupos.
RADAR_DM_POR_COLEGA_DIA=2

# Respuesta automatica dentro del grupo.
#
# Tres modos, de menos a mas expuesto:
#
#   sombra    redacta el mensaje del grupo, lo registra y NO lo publica.
#   asistido  NO publica nada. Sofi revalida las candidatas y, si aprueba, le
#             escribe a la asesora con el grupo, el colega, lo que pidio y que
#             propiedad le sirve. Es el modo de calibracion.
#   auto      publica la respuesta dentro del grupo.
#
# Cualquier otro valor apaga la respuesta.
GRUPOS_RESPUESTA_MODO=asistido

# ── Radar: carril de COMPRA (mandatos) ────────────────────────────────────────
# Margen sobre el tope de precio de un mandato que todavia se considera "se
# acerca". 0.15 = hasta 15% arriba. Mas que eso no se avisa.
RADAR_MANDATO_MARGEN_PRECIO=0.15
# Tope de avisos por mandato por dia. 0 = sin limite (default de producto: un
# tope que descarta matches buenos deja plata sobre la mesa). Se pone un numero
# solo si el asesor se ahoga.
RADAR_MANDATO_MAX_DIA=0
# Plantilla aprobada en Meta para entrar cuando la ventana de 24h esta cerrada.
RADAR_MANDATO_TEMPLATE=radar_match_mandato
# A quien se le escala un match que NO se pudo entregar al dueño del mandato.
# Cae a RADAR_REVISOR_PHONE si esta vacia.
RADAR_ESCALADO_PHONE=

# A quien mas se le avisa en modo asistido, ademas de la asesora de la rotacion
# de venta. Telefonos separados por coma. Durante la calibracion conviene
# sumarte: tu ventana de 24h con Sofi la mantiene abierta el watchdog, asi que
# el aviso siempre llega al menos a un lado.
RADAR_ALERTA_TO=

# Quien revisa los "casi" del radar en modo auto/sombra (Juan, 2026-08-20): un
# pedido que se callo SOLO por quedar bajo el umbral de puntaje (nunca por
# zona equivocada ni por ser propiedad de un aliado) le llega por WhatsApp a
# este telefono, y si responde "si" desde su propio chat con Sofi, se publica
# por la misma via auditada que el camino automatico. Tiene que ser un
# telefono ya dado de alta en advisors — sin eso, no se manda el aviso.
RADAR_REVISOR_PHONE=

# Escalado a Catherine si Natalia (asesor PRINCIPAL del radar) no responde el
# aviso en RADAR_SILENCIO_MIN minutos, en los dos carriles (venta y compra).
RADAR_SILENCIO_MIN=30
# Cada cuanto corre el chequeo de silencio.
RADAR_SILENCIO_INTERVAL_MIN=5

# Inbox pasivo de la linea vinculada (Juan, 2026-08-21): cada mensaje DIRECTO
# (no de grupo) que le llegue a esa linea se guarda en la tabla linea_dm, se
# clasifica con Haiku, y si el hilo muestra avance real hacia una venta
# (fecha/hora de visita, conversacion de agenda, o cualquier señal de posible
# venta) se le avisa por WhatsApp a este telefono — por la linea OFICIAL de
# Sofi, nunca por la vinculada. NO responde nada al colega: es lectura y
# alerta, no un canal de conversacion.
#
# EXISTE SOLO PORQUE la linea vinculada es 100% dedicada al radar, sin uso
# personal (confirmado por Juan) — ver la nota completa en
# db/migrations/2026-08-21_linea_dm.sql antes de activar esto en una linea
# que si tenga chats personales.
#
# Sin este telefono, los DM se siguen guardando y clasificando igual, pero no
# se manda ninguna alerta. El mismo telefono lo reusa el cruce diario
# visitas -> ventas de abajo.
RADAR_VISITAS_ALERTA_TO=

# Hora (Colombia, 24h) del cruce diario visitas -> ventas (Juan, 2026-08-21):
# de las visitas/avances que el sistema pudo capturar (cliente directo con
# Sofi, o colega en la linea de Natalia), revisa cuales propiedades ya no
# estan disponibles y avisa "posible venta" a RADAR_VISITAS_ALERTA_TO. Correr
# despues de que el sync de Wasi (DMAP) ya actualizo el inventario del dia.
VISITAS_VENTA_HORA=8

# Modelo con el que Sofi revalida. Sonnet por defecto: esto es juicio, no
# extraccion, y el volumen es bajo (solo demandas que ya trajeron candidata).
CLAUDE_MODEL_REVALIDAR=
# Puntaje minimo para publicar una propiedad. Ojo: la escala de match.js va de
# 55 a 100, no de 0 a 100. Medido contra el inventario real, el techo sin pedir
# alcobas es 73; con 80 el bot queda mudo.
GRUPOS_RESPUESTA_UMBRAL=70
GRUPOS_RESPUESTA_CONFIANZA=0.85
# Tope diario de respuestas por grupo. 0 = SIN LIMITE, y ese es el default: si
# entran mil pedidos y para los mil hay algo que ofrecer, se responden los mil.
# Queda configurable por si el gremio reacciona mal al volumen.
#
# Ojo: el "maximo 3" del producto son las PROPIEDADES que van dentro de una
# respuesta, no la cantidad de respuestas.
GRUPOS_RESPUESTA_MAX_DIA=0
# Segundos entre dos publicaciones seguidas en el mismo grupo. NO es un tope y
# no descarta nada: el pedido que venga atras espera su turno en la cola y se
# responde igual. Solo evita disparar dos envios en el mismo segundo. 0 lo apaga.
GRUPOS_RESPUESTA_ESPACIADO_SEG=20
# Margen de captura sobre el techo de precio y bajo el piso de area pedidos
# (Juan, 2026-08-20): un match que se pasa un poco del presupuesto o le falta
# un poco de metros ya no se descarta de plano. Alcobas/banos/garajes/estrato
# NO llevan margen, siguen exactos.
GRUPOS_MARGEN_PRECIO=0.10
GRUPOS_MARGEN_AREA=0.10
# Refs que no salen al grupo aunque hagan match. Se corrigen en Wasi y se sacan
# de aca; mientras tanto, no se publican.
GRUPOS_REFS_BLOQUEADAS=9921388
# Horas que puede tener el ultimo sync exitoso de Wasi para seguir confiando en
# el inventario. Pasado ese plazo el radar NO publica: si el sync se detuvo, no
# se sabe que se vendio desde entonces.
GRUPOS_SYNC_MAX_HORAS=30
# Numero de WhatsApp que se ofrece como "linea oficial" de Sofi en:
#   - el mensaje que se publica en el grupo gremial y en el DM directo al
#     colega (src/groups/redactar.js#mensajeGrupo, mismo texto para los dos);
#   - los avisos A LA ASESORA de los modos asistido/sombra
#     (alerta-asesor.js, aviso-cercano.js).
# Antes existian dos variables (SOFI_WHATSAPP_NUMBER con default hardcodeado
# para el primer caso, CONTACT_WHATSAPP_NUMBER para el segundo) que en la
# practica guardaban el mismo numero -- se unificaron en esta sola (Juan,
# revision 2026-08-24) porque tener dos fuentes para un mismo dato es lo que
# dejaba a redactar.js con un default de Diamond hardcodeado, rompiendo
# multi-tenant.
#
# Solo digitos, con indicativo, sin '+'. Sin definirla, esos mensajes salen
# SIN el renglon "escribile a Sofi" (nunca con un link a medias: ver
# src/lib/contacto.js#linkContactoOficial). Multi-tenant (revision
# 2026-08-24): si la organizacion tiene su propio numero en
# organizations.contact_whatsapp_number (ver
# db/migrations/2026-08-24_contact_whatsapp_number.sql), ese manda y esta
# variable queda como default para cuando la org no lo tiene.
CONTACT_WHATSAPP_NUMBER=573044653609

# ── Watchdog del radar ────────────────────────────────────────────────────
#
# Los fallos de este ecosistema son silenciosos: el baneo de julio se descubrio
# porque alguien abrio una pantalla, y el sync de Wasi se salteo cinco dias
# seguidos sin dejar mas rastro que un hueco en una tabla.
#
# Avisa por la linea OFICIAL de Sofi (Cloud API), nunca por la vinculada — si lo
# que se cayo es esa linea, avisar por ahi no serviria de nada.
#
# SIN destinatario el watchdog NO arranca: un vigilante que no tiene a quien
# llamar no es un vigilante. Telefonos separados por coma.
RADAR_WATCHDOG_TO=
RADAR_WATCHDOG_INTERVAL_MIN=30
